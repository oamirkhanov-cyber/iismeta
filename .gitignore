# ЗАЩИТА ВИТРИНЫ: сюда НИКОГДА не должны попасть нормативная база,
# эталоны и проектная документация заказчиков.
# Исходный код публикуется ТОЛЬКО в отобранном виде внутри code/.

# нормативная и эталонная база — никогда
*.sqlite
*.sqlite-*
*.db
*.gz
*.json
*.jsonl
*.csv

# проектная документация заказчиков — КОНФИДЕНЦИАЛЬНО
*.xls
*.xlsx
*.doc
*.docx
*.pdf
*.dwg

# код движка вне code/ — блокируется
/*.py
/*.js
/docs/**/*.py
/docs/**/*.js

# секреты и мусор
.env
*.env
**/__pycache__/
*.pyc
.DS_Store
*.log
